<?xml version="1.0"?>
<!--
  myCobot 280 Jetson Nano arm, as a reusable macro.

  Kinematics (joint origins) and joint limits come from Elephant Robotics' mycobot_280_jn.urdf
  (github.com/elephantrobotics/mycobot_ros2, branch humble, BSD-2-Clause). The joint limits
  match the ones pymycobot enforces for MyCobot280. Meshes were converted with
  tools/convert_meshes.py: metres, already in each link's frame, so visual origins are identity.

  Frames: base_link (bottom of the Jetson base) -> link1..link6 -> flange (tool mounting frame).
  Joint i of the real arm is ${prefix}joint<i>. Positive directions still have to be checked
  against the real arm, joint by joint (see README).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Generated by tools/convert_meshes.py. lazy_eval="false" loads it now, relative to this file. -->
  <xacro:property name="mycobot_inertials" lazy_eval="false"
    value="${xacro.load_yaml('mycobot_280_jn_inertials.yaml')}"/>

  <xacro:property name="mesh_dir" value="package://mimesis_description/meshes/mycobot_280_jn"/>

  <!-- PLACEHOLDERS: not measured yet. Velocity in rad/s, effort in N*m. -->
  <xacro:property name="max_velocity" value="1.0"/>
  <xacro:property name="max_effort" value="2.0"/>

  <material name="mimesis_dark">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>
  <material name="mimesis_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>

  <!-- One link with visual, collision and inertial blocks. -->
  <xacro:macro name="mycobot_link" params="prefix name material">
    <link name="${prefix}${name}">
      <visual>
        <geometry>
          <mesh filename="${mesh_dir}/visual/${name}.stl"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_dir}/collision/${name}.stl"/>
        </geometry>
      </collision>
      <xacro:property name="i" value="${mycobot_inertials[name]}"/>
      <inertial>
        <origin xyz="${i['com']}" rpy="0 0 0"/>
        <mass value="${i['mass']}"/>
        <inertia ixx="${i['ixx']}" ixy="${i['ixy']}" ixz="${i['ixz']}"
                 iyy="${i['iyy']}" iyz="${i['iyz']}" izz="${i['izz']}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- One revolute joint. Limits are given in degrees, as in pymycobot. -->
  <xacro:macro name="mycobot_joint" params="prefix index parent child xyz rpy lower_deg upper_deg">
    <joint name="${prefix}joint${index}" type="revolute">
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(lower_deg)}" upper="${radians(upper_deg)}"
             velocity="${max_velocity}" effort="${max_effort}"/>
    </joint>
  </xacro:macro>

  <!--
    The whole arm.
      prefix: prepended to every link and joint name (lets two arms share one TF tree)
      parent: link the arm is mounted on
      origin: block giving the pose of base_link in parent
  -->
  <xacro:macro name="mycobot_280_jn" params="prefix parent *origin">

    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <xacro:mycobot_link prefix="${prefix}" name="base_link" material="mimesis_dark"/>
    <xacro:mycobot_link prefix="${prefix}" name="link1" material="mimesis_white"/>
    <xacro:mycobot_link prefix="${prefix}" name="link2" material="mimesis_white"/>
    <xacro:mycobot_link prefix="${prefix}" name="link3" material="mimesis_white"/>
    <xacro:mycobot_link prefix="${prefix}" name="link4" material="mimesis_white"/>
    <xacro:mycobot_link prefix="${prefix}" name="link5" material="mimesis_white"/>
    <xacro:mycobot_link prefix="${prefix}" name="link6" material="mimesis_dark"/>

    <xacro:mycobot_joint prefix="${prefix}" index="1" parent="base_link" child="link1"
      xyz="0 0 0.15756" rpy="0 0 0" lower_deg="-168" upper_deg="168"/>
    <xacro:mycobot_joint prefix="${prefix}" index="2" parent="link1" child="link2"
      xyz="0 0 -0.001" rpy="0 ${pi/2} ${-pi/2}" lower_deg="-140" upper_deg="140"/>
    <xacro:mycobot_joint prefix="${prefix}" index="3" parent="link2" child="link3"
      xyz="-0.1104 0 0" rpy="0 0 0" lower_deg="-150" upper_deg="150"/>
    <xacro:mycobot_joint prefix="${prefix}" index="4" parent="link3" child="link4"
      xyz="-0.096 0 0.06462" rpy="0 0 ${-pi/2}" lower_deg="-150" upper_deg="150"/>
    <xacro:mycobot_joint prefix="${prefix}" index="5" parent="link4" child="link5"
      xyz="0 -0.07318 0" rpy="${pi/2} ${-pi/2} 0" lower_deg="-155" upper_deg="160"/>
    <xacro:mycobot_joint prefix="${prefix}" index="6" parent="link5" child="link6"
      xyz="0 0.0456 0" rpy="${-pi/2} 0 0" lower_deg="-180" upper_deg="180"/>

    <!-- Tool mounting frame. Same place as link6 for now; move it once the face is measured. -->
    <link name="${prefix}flange"/>
    <joint name="${prefix}flange_joint" type="fixed">
      <parent link="${prefix}link6"/>
      <child link="${prefix}flange"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
